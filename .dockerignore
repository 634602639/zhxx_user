# 别让宿主的 venv / 缓存 / 临时文件污染镜像
backend/venv/
backend/__pycache__/
**/__pycache__/
**/*.pyc

# 运行期产物（容器内会重新生成，并通过 volume 挂载）
backend/data/
backend/uploads/
backend/exports/

# PyInstaller 打包产物（仅本机打 exe 用，与 Docker 无关，别进镜像）
backend/build/
backend/dist/
backend/*.spec

# 本地杂项
_tmp_head.html
.git/
.gitignore
.vscode/
.idea/
*.log
*.bak

# Docker 自己别套娃
Dockerfile
.dockerignore
docker-compose.yml
